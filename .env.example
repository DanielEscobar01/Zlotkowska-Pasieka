# URL del proyecto; se copia desde la configuración API de Supabase.
# URL projektu; skopiuj ją z ustawień API Supabase.
VITE_SUPABASE_URL=
# Clave pública publishable/anon. Nunca poner aquí la clave secreta service_role.
# Publiczny klucz publishable/anon. Nigdy nie umieszczaj tu tajnego klucza service_role.
VITE_SUPABASE_ANON_KEY=
# Correo del usuario Auth permitido por la interfaz de administración.
# E-mail użytkownika Auth dopuszczonego przez interfejs administracyjny.
VITE_SUPABASE_ADMIN_EMAIL=